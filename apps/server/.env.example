# Database
DATABASE_URL="file:./prisma/dev.db"

# Server
PORT=3001
HOST=0.0.0.0
# Origens permitidas no CORS (separadas por virgula)
# Exemplo: CORS_ORIGINS=https://meusite.com,https://admin.meusite.com,http://200.96.7.196:5173
CORS_ORIGINS=http://200.96.7.196:5173,http://200.96.7.196,https://200.96.7.196
LOG_LEVEL=info

# JWT
JWT_SECRET="dev-secret-key-change-in-production"

# Node
NODE_ENV=development
